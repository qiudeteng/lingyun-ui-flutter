# frozen_string_literal: true

require "fileutils"
require "json"
require "open3"
require "securerandom"
require "tmpdir"

require_relative "ci_support"

default_platform(:ios)

platform :ios do
  before_all do
    ENV["FASTLANE_OPT_OUT_USAGE"] = "1"
    ENV["FASTLANE_SKIP_UPDATE_CHECK"] = "1"
    ENV["FASTLANE_HIDE_CHANGELOG"] = "1"
    ENV["FASTLANE_DISABLE_ANIMATION"] = "1"
  end

  desc "Archive example/ and upload to TestFlight. Does not submit for App Review or beta review."
  lane :beta do
    upload_example_to_testflight
  end
end

def upload_example_to_testflight
  reset_signing_state!
  keychain_password = nil

  begin
    unless ENV["CI"] == "true" || ENV["LINGYUN_ALLOW_LOCAL_SIGNING"] == "1"
      UI.user_error!("这条 lane 会创建临时钥匙串。GitHub Actions 已设置 CI=true。本机调试请先导出 LINGYUN_ALLOW_LOCAL_SIGNING=1。")
    end
    UI.user_error!("需要 macOS runner（workflow 使用 macos-latest）。") unless FastlaneCore::Helper.mac?

    %w[
      APP_STORE_CONNECT_ISSUER_ID
      APP_STORE_CONNECT_KEY_ID
      APP_STORE_CONNECT_API_KEY_P8
      IOS_DISTRIBUTION_CERT_P12_BASE64
      IOS_DISTRIBUTION_CERT_PASSWORD
    ].each do |name|
      UI.user_error!("缺少环境变量 #{name}。步骤见 docs/IOS-TESTFLIGHT.md。") if ENV[name].to_s.strip.empty?
    end

    ios_dir = ios_directory
    example_dir = File.expand_path("..", ios_dir)
    pubspec = File.read(File.join(example_dir, "pubspec.yaml"))
    build_name = CiSupport.marketing_version(pubspec, ENV["BUILD_NAME"])
    build_number = CiSupport.build_number(ENV["BUILD_NUMBER"], ENV["GITHUB_RUN_NUMBER"])
    private_key = CiSupport.normalize_private_key(ENV.fetch("APP_STORE_CONNECT_API_KEY_P8"))
    UI.message("示例应用 #{CiSupport::APP_IDENTIFIER}，营销版本 #{build_name}，构建号 #{build_number}")

    team_id = CiSupport.normalize_team_id(ENV["APPLE_TEAM_ID"])
    if team_id.empty?
      UI.message("未设置 APPLE_TEAM_ID，从 Bundle ID 的 seedId 读取 Team ID。")
      team_id = fetch_seed_team_id(private_key)
    end
    UI.message("Team ID #{team_id}")

    unless flutter_on_path?
      UI.user_error!("PATH 中没有 flutter。workflow 需要 subosito/flutter-action。")
    end

    keychain_password = prepare_distribution_keychain!
    identity = distribution_identity(team_id)
    certificate_kind = CiSupport.signing_certificate_kind(identity)
    profile_name = install_app_store_profile!(team_id)

    export_plist = File.join(@work_dir, "ExportOptions.plist")
    File.write(
      export_plist,
      CiSupport.export_options_plist(
        team_id: team_id,
        certificate: certificate_kind,
        profile_name: profile_name,
        bundle_id: CiSupport::APP_IDENTIFIER
      )
    )
    apply_release_signing!(ios_dir: ios_dir, team_id: team_id, identity: identity, profile_name: profile_name)
    unlock_keychain!(keychain_password)

    run_flutter_ipa!(
      example_dir: example_dir,
      build_name: build_name,
      build_number: build_number,
      export_plist: export_plist
    )

    ipas = Dir[File.join(example_dir, "build", "ios", "ipa", "*.ipa")]
    UI.user_error!("flutter build ipa 没有产出 IPA。") if ipas.empty?
    UI.user_error!("产出了多个 IPA：#{ipas.join(', ')}") if ipas.length > 1
    ipa_path = ipas.first
    UI.message("IPA #{ipa_path}")

    # Fresh token: the archive can outlive the 20-minute API token used for sigh.
    upload_to_testflight(
      api_key: asc_api_key,
      ipa: ipa_path,
      app_identifier: CiSupport::APP_IDENTIFIER,
      skip_submission: true,
      skip_waiting_for_build_processing: true,
      distribute_external: false,
      notify_external_testers: false,
      uses_non_exempt_encryption: false,
      expire_previous_builds: false,
      reject_build_waiting_for_review: false,
      submit_beta_review: false
    )

    summary = ENV["GITHUB_STEP_SUMMARY"].to_s
    unless summary.empty?
      File.open(summary, "a") do |file|
        file.puts "已上传 TestFlight：#{build_name} (#{build_number})，Bundle ID `#{CiSupport::APP_IDENTIFIER}`。"
        file.puts "未提交 App Review，也未送外部测试审核。处理完成后在 App Store Connect → TestFlight 查看。"
      end
    end
    UI.success("已上传 TestFlight #{build_name} (#{build_number})。未提交审核。")
  rescue CiSupport::Error => e
    UI.user_error!(e.message)
  ensure
    cleanup_signing_material!
  end
end

def run_flutter_ipa!(example_dir:, build_name:, build_number:, export_plist:)
  # bundle exec hooks Process.spawn and puts GEM_HOME/RUBYOPT back even if the
  # caller deleted them. with_unbundled_env removes that hook for the block.
  with_unbundled_env do
    bindir = RbConfig::CONFIG.fetch("bindir")
    pod = File.join(bindir, "pod")
    unless File.executable?(pod)
      UI.user_error!("#{bindir} 里没有可执行的 pod。工作流应先把 CocoaPods 装进 setup-ruby 的 Ruby。")
    end

    ENV["PATH"] = CiSupport.flutter_command_env(ENV.to_h, pod_bindir: bindir).fetch("PATH")
    stdout, stderr, status = Open3.capture3(pod, "--version")
    version = stdout.to_s.strip
    unless status.success? && CiSupport.pod_version_acceptable?(version)
      detail = stderr.to_s.strip
      detail = stdout.to_s.strip if detail.empty?
      detail = "（无输出）" if detail.empty?
      UI.user_error!("#{pod} --version 失败：#{detail}。Flutter 会跳过 pod install。")
    end
    UI.message("Flutter 将使用 #{pod} #{version}")

    Dir.chdir(example_dir) do
      sh(
        "flutter", "build", "ipa", "--release",
        "--build-name", build_name,
        "--build-number", build_number,
        "--export-options-plist", export_plist
      )
    end
  end
end

def with_unbundled_env(&block)
  if defined?(Bundler) && Bundler.respond_to?(:with_unbundled_env)
    Bundler.with_unbundled_env(&block)
  else
    yield
  end
end

def flutter_on_path?
  ENV.fetch("PATH", "").split(File::PATH_SEPARATOR).any? do |dir|
    File.executable?(File.join(dir, "flutter"))
  end
end

def ios_directory
  CiSupport.ios_directory(Dir.pwd)
rescue CiSupport::Error => e
  UI.user_error!(e.message)
end

def asc_api_key
  app_store_connect_api_key(
    key_id: ENV.fetch("APP_STORE_CONNECT_KEY_ID").strip,
    issuer_id: ENV.fetch("APP_STORE_CONNECT_ISSUER_ID").strip,
    key_content: CiSupport.normalize_private_key(ENV.fetch("APP_STORE_CONNECT_API_KEY_P8")),
    is_key_content_base64: false,
    duration: 1140,
    in_house: false
  )
end

def fetch_seed_team_id(private_key)
  require "jwt"
  require "net/http"
  require "openssl"

  key = OpenSSL::PKey.read(private_key)
  now = Time.now.to_i
  token = JWT.encode(
    {
      iss: ENV.fetch("APP_STORE_CONNECT_ISSUER_ID").strip,
      iat: now,
      exp: now + (19 * 60),
      aud: "appstoreconnect-v1"
    },
    key,
    "ES256",
    { kid: ENV.fetch("APP_STORE_CONNECT_KEY_ID").strip, typ: "JWT" }
  )
  uri = URI("https://api.appstoreconnect.apple.com/v1/bundleIds")
  uri.query = URI.encode_www_form(
    "filter[identifier]" => CiSupport::APP_IDENTIFIER,
    "limit" => "10"
  )
  request = Net::HTTP::Get.new(uri)
  request["Authorization"] = "Bearer #{token}"
  request["Accept"] = "application/json"
  response = Net::HTTP.start(uri.hostname, uri.port, use_ssl: true, open_timeout: 30, read_timeout: 60) do |http|
    http.request(request)
  end
  body_text = response.body.to_s
  unless response.is_a?(Net::HTTPSuccess)
    detail = body_text.gsub(/\s+/, " ")[0, 400]
    UI.user_error!(
      "读取 Bundle ID 失败（HTTP #{response.code}）：#{detail}\n" \
      "请设置 secret APPLE_TEAM_ID（Developer 门户里的 10 位 Team ID，不是 Issuer ID）。" \
      "列出 Bundle ID 需要能访问 Certificates, Identifiers & Profiles 的 API Key，角色一般是 Admin。"
    )
  end
  CiSupport.team_id_from_bundle_ids_json(JSON.parse(body_text), bundle_id: CiSupport::APP_IDENTIFIER)
rescue OpenSSL::PKey::PKeyError, JWT::EncodeError => e
  UI.user_error!("APP_STORE_CONNECT_API_KEY_P8 无法用来签名 API 请求：#{e.message}")
rescue JSON::ParserError, SocketError, Timeout::Error, SystemCallError, OpenSSL::SSL::SSLError => e
  UI.user_error!("连接 App Store Connect 失败：#{e.class}: #{e.message}。也可以直接设置 secret APPLE_TEAM_ID。")
end

def prepare_distribution_keychain!
  password = ENV.fetch("IOS_DISTRIBUTION_CERT_PASSWORD")
  UI.user_error!("IOS_DISTRIBUTION_CERT_PASSWORD 是空的。导出 p12 时请设置非空密码。") if password.strip.empty?

  bytes = CiSupport.decode_base64_blob(
    ENV.fetch("IOS_DISTRIBUTION_CERT_P12_BASE64"),
    label: "IOS_DISTRIBUTION_CERT_P12_BASE64"
  )
  @work_dir = Dir.mktmpdir("lingyun-signing")
  @p12_path = File.join(@work_dir, "distribution.p12")
  File.binwrite(@p12_path, bytes)
  File.chmod(0o600, @p12_path)

  @keychain_name = "lingyun-ci"
  @keychain_candidates = [
    File.expand_path("~/Library/Keychains/#{@keychain_name}-db"),
    File.expand_path("~/Library/Keychains/#{@keychain_name}")
  ]
  # Prefer the -db path so cleanup can remove it even if create_keychain fails halfway.
  @keychain_path = @keychain_candidates.first
  @original_default = `security default-keychain 2>/dev/null`.strip.gsub(/\A"+|"+\z/, "")
  @original_keychains = `security list-keychains -d user 2>/dev/null`.scan(/"([^"]+)"/).flatten
  @keychain_candidates.each do |path|
    next unless File.exist?(path)
    UI.user_error!("无法删除已有临时钥匙串 #{path}") unless system("security", "delete-keychain", path)
  end

  keychain_password = SecureRandom.hex(24)
  create_keychain(
    name: @keychain_name,
    password: keychain_password,
    default_keychain: true,
    unlock: true,
    timeout: 0,
    lock_when_sleeps: false,
    lock_after_timeout: false,
    add_to_search_list: false,
    require_create: true
  )
  @keychain_path = @keychain_candidates.find { |path| File.exist?(path) }
  UI.user_error!("临时钥匙串没有创建出来：#{@keychain_candidates.join(' 或 ')}") unless @keychain_path

  sh("security", "list-keychains", "-d", "user", "-s", @keychain_path)
  sh("security", "default-keychain", "-s", @keychain_path)
  unlock_keychain!(keychain_password)

  import_out, import_status = Open3.capture2e(
    "security", "import", @p12_path,
    "-k", @keychain_path,
    "-P", password,
    "-f", "pkcs12",
    "-T", "/usr/bin/codesign",
    "-T", "/usr/bin/security"
  )
  File.delete(@p12_path) if File.exist?(@p12_path)
  @p12_path = nil
  unless import_status.success?
    UI.user_error!("导入 p12 失败。请检查密码，并确认文件同时包含证书和私钥。\n#{redact(import_out, password, keychain_password)}")
  end

  partition_out, partition_status = Open3.capture2e(
    "security", "set-key-partition-list",
    "-S", "apple-tool:,apple:,codesign:",
    "-s",
    "-k", keychain_password,
    @keychain_path
  )
  unless partition_status.success?
    UI.user_error!("无法授权 codesign 使用这张证书：#{redact(partition_out, password, keychain_password)}")
  end
  keychain_password
end

def distribution_identity(team_id)
  identity_output = sh("security", "find-identity", "-v", "-p", "codesigning", @keychain_path)
  identity = CiSupport.prefer_distribution_identity(CiSupport.distribution_identities(identity_output))
  if identity.nil?
    UI.user_error!(
      "临时钥匙串里没有 Apple Distribution / iPhone Distribution 身份。" \
      "常见原因：p12 密码不对、p12 不含私钥，或证书是 Development 而不是 Distribution。\n#{identity_output}"
    )
  end
  CiSupport.assert_same_team!(identity, team_id)
  UI.message("签名身份：#{identity}")
  identity
end

def install_app_store_profile!(team_id)
  supplied = ENV["IOS_APPSTORE_PROFILE_BASE64"].to_s
  if supplied.strip.empty?
    UI.message(
      "用 API 创建或更新 App Store 描述文件 #{CiSupport::PROFILE_NAME}。" \
      "API Key 需要 Admin（能管理 Certificates, Identifiers & Profiles）。" \
      "如果这里 403，改为提供 secret IOS_APPSTORE_PROFILE_BASE64。"
    )
    # Do not pass adhoc/development, even as false. Fastlane 2.241 treats an
    # explicit false as enabled for sigh's conflicting_options check.
    # Unset flags default to false and select an App Store profile.
    sigh(
      api_key: asc_api_key,
      **CiSupport.app_store_sigh_options(team_id: team_id, output_path: @work_dir)
    )
    profile_path = File.join(@work_dir, "appstore.mobileprovision")
    unless File.exist?(profile_path)
      found = Dir[File.join(@work_dir, "*.mobileprovision")]
      profile_path = found.first if found.length == 1
    end
  else
    UI.message("安装 IOS_APPSTORE_PROFILE_BASE64，不调用 sigh。")
    profile_bytes = CiSupport.decode_base64_blob(supplied, label: "IOS_APPSTORE_PROFILE_BASE64")
    profile_path = File.join(@work_dir, "appstore.mobileprovision")
    File.binwrite(profile_path, profile_bytes)
    install_provisioning_profile(path: profile_path)
  end
  UI.user_error!("找不到描述文件") unless profile_path && File.exist?(profile_path)

  # Trailing hash: Fastfile#sh only treats a positional Hash as options (Ruby 3 keywords are not collected into *args).
  profile_plist = sh("security", "cms", "-D", "-i", profile_path, { log: false })
  profile_name, = CiSupport.assert_profile!(profile_plist, bundle_id: CiSupport::APP_IDENTIFIER)
  UI.message("描述文件：#{profile_name}")
  profile_name
end

def apply_release_signing!(ios_dir:, team_id:, identity:, profile_name:)
  require "xcodeproj"

  project = Xcodeproj::Project.open(File.join(ios_dir, "Runner.xcodeproj"))
  runner = project.targets.find { |target| target.name == "Runner" }
  UI.user_error!("找不到 Runner target") if runner.nil?

  release = runner.build_configurations.find { |config| config.name == "Release" }
  UI.user_error!("找不到 Runner Release 配置") if release.nil?
  bundle_id = release.build_settings["PRODUCT_BUNDLE_IDENTIFIER"]
  unless bundle_id == CiSupport::APP_IDENTIFIER
    UI.user_error!("Runner Release 的 Bundle ID 是 #{bundle_id}，应为 #{CiSupport::APP_IDENTIFIER}")
  end

  settings = release.build_settings
  settings["CODE_SIGN_STYLE"] = "Manual"
  settings["DEVELOPMENT_TEAM"] = team_id
  settings["CODE_SIGN_IDENTITY"] = identity
  settings["CODE_SIGN_IDENTITY[sdk=iphoneos*]"] = identity
  settings["PROVISIONING_PROFILE_SPECIFIER"] = profile_name
  settings.delete("PROVISIONING_PROFILE")

  # Project-level `CODE_SIGN_IDENTITY[sdk=iphoneos*]` is "iPhone Developer" and wins over a
  # generic target identity. Set the sdk-specific value on the target and the Release project config.
  project.build_configurations.each do |config|
    next unless config.name == "Release"

    config.build_settings["CODE_SIGN_IDENTITY"] = identity
    config.build_settings["CODE_SIGN_IDENTITY[sdk=iphoneos*]"] = identity
  end
  project.save
end

def unlock_keychain!(keychain_password)
  # Do not pass the password through Fastlane's logged sh().
  _output, status = Open3.capture2e("security", "unlock-keychain", "-p", keychain_password, @keychain_path)
  UI.user_error!("无法解锁临时钥匙串") unless status.success?
end

def redact(text, *secrets)
  secrets.compact.reduce(text.to_s) { |current, secret| secret.empty? ? current : current.gsub(secret, "[redacted]") }
end

def reset_signing_state!
  @p12_path = nil
  @work_dir = nil
  @keychain_name = nil
  @keychain_path = nil
  @keychain_candidates = nil
  @original_default = nil
  @original_keychains = nil
end

def cleanup_signing_material!
  File.delete(@p12_path) if @p12_path && File.exist?(@p12_path)
  FileUtils.remove_entry(@work_dir) if @work_dir && File.directory?(@work_dir)
  if @original_keychains && !@original_keychains.empty?
    system("security", "list-keychains", "-d", "user", "-s", *@original_keychains)
  end
  if @original_default && !@original_default.empty? && File.exist?(@original_default)
    system("security", "default-keychain", "-s", @original_default)
  end
  (Array(@keychain_candidates) + Array(@keychain_path)).uniq.each do |path|
    system("security", "delete-keychain", path) if path && File.exist?(path)
  end
rescue StandardError
  nil
end
